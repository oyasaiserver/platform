{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/docs/02_Docs/ops/agent-footprint-logging/footprint-log.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "FILE=$(jq -r '.tool_input.file_path // empty'); if [[ -z \"$FILE\" ]]; then exit 0; fi; if [[ \"$FILE\" =~ (^|/)(gradle\\.lock|flake\\.lock)$ ]] || [[ \"$FILE\" =~ (^|/)result$ ]]; then echo 'ロックファイル/result シンボリックリンクは手動編集禁止。nix flake update / gradle2nix 経由で更新してください。' >&2; exit 2; fi; exit 0",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/docs/02_Docs/ops/agent-footprint-logging/footprint-stop.sh\"",
            "type": "command"
          }
        ]
      }
    ]
  }
}
