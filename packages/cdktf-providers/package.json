{
  "name": "cdktf-providers",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@anterior/brrr": "0.1.264",
    "@hono/node-server": "^1.19.10",
    "@hono/otel": "^0.6.0",
    "hono": "^4.12.7",
    "hono-pino": "^0.10.3",
    "zod": "~4.1.12"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/node": "^24.8.1"
  }
}
