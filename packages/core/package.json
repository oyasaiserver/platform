{
  "name": "@oyasaiserver/core",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.cjs",
  "bin": "dist/bin",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "deploy": "tsx scripts/deploy.ts",
    "prestart": "npm run build",
    "start": "cp dist/bin server && cd server && ./bin"
  },
  "config": {
    "sea": {
      "file": "sea-config.json",
      "main": "dist/index.cjs",
      "output": "dist/sea.blob",
      "disableExperimentalSEAWarning": true
    }
  },
  "dependencies": {
    "decompress": "^4.2.1",
    "webpod": "^1.0.0"
  },
  "devDependencies": {
    "@types/decompress": "^4.2.7",
    "postject": "^1.0.0-alpha.6",
    "tsup": "^8.5.0"
  }
}
