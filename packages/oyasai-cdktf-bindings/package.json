{
  "name": "@oyasaiserver/cdktf-bindings",
  "type": "module",
  "exports": {
    "./modules/*": {
      "import": "./dist/modules/*.js",
      "types": "./dist/modules/*.d.ts"
    },
    "./providers/*": {
      "import": "./dist/providers/*/index.js",
      "types": "./dist/providers/*/index.d.ts"
    }
  },
  "bin": {
    "cdktf": "cdktf"
  },
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "cdktf": "0.21.0",
    "cdktf-cli": "0.21.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "typescript": "7.0.2"
  }
}
