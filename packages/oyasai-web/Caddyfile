{
  admin off
  auto_https off
}

:80 {
  root * {$OYASAI_WEB_DATA:/data}/current/site
  route {
    @unavailable not file /index.html
    respond @unavailable "Wiki を準備しています。しばらくしてから再度お試しください。" 503
    file_server
  }
  handle_errors {
    @notfound expression {err.status_code} == 404
    handle @notfound {
      rewrite * /404.html
      file_server
    }
    respond "ページを表示できません。しばらくしてから再度お試しください。" {err.status_code}
  }
}
