FROM docker.io/library/node:24.22.0-bookworm-slim@sha256:ec857ea6bb60cb3d0fa4d97495590c5fe7d51be8572c307b55957eeb06569cf7 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev --ignore-scripts

FROM docker.io/library/node:24.22.0-bookworm-slim@sha256:ec857ea6bb60cb3d0fa4d97495590c5fe7d51be8572c307b55957eeb06569cf7
COPY --from=build /app /app
USER node
ENV HOME=/workspace
WORKDIR /workspace
ENTRYPOINT ["node", "/app/dist/main.js", "/docs"]
CMD ["deepseek/deepseek-v4.1-flash", "--container"]
