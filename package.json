{
  "name": "platform",
  "description": "Platform for Oyasai Server",
  "type": "module",
  "scripts": {
    "check": "biome check --write && sort-package-json --quiet",
    "commit": "git add --all && cz",
    "start": "tsx src",
    "test": "tsx --test",
    "typecheck": "tsc --build"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^22.15.21",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "sort-package-json": "^3.2.1",
    "typescript": "^5.8.3"
  }
}
