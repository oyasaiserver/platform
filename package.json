{
  "type": "module",
  "workspaces": [
    "apps/*",
    "bin",
    "gen/json/ts",
    "gen/proto/ts",
    "infra/*",
    "lib/ts",
    "packages/*",
    "schema/ts"
  ],
  "scripts": {
    "build": "tsc --build",
    "bump": "taze",
    "check": "sort-package-json '**/package.json' --quiet && buf format --write && gradle spotlessApply",
    "codegen": "codegen && npm run lint",
    "lint": "eslint --fix"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.55.1",
    "@eslint/compat": "^1.3.1",
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.12",
    "eslint": "^9.30.1",
    "sort-package-json": "^3.4.0",
    "taze": "^19.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "wrangler": "^4.24.0",
    "zod": "^3.25.76",
    "zx": "^8.6.2"
  }
}
