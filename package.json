{
  "name": "platform",
  "description": "Platform for Oyasai Server",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/*",
    "tests"
  ],
  "scripts": {
    "build": "tsc --build",
    "check": "biome check --write && sort-package-json --quiet",
    "codegen": "env-codegen"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.44.1",
    "@oyasaiserver/env": "^1.0.0",
    "tsx": "^4.19.4",
    "zx": "^8.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^22.15.21",
    "sort-package-json": "^3.2.1",
    "typescript": "^5.8.3"
  }
}
