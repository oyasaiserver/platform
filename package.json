{
  "dependencies": {
    "@oyasaiserver/codegen": "^1.0.0",
    "@oyasaiserver/gen": "^1.0.0",
    "@oyasaiserver/platform": "^1.0.0",
    "zx": "^8.5.5"
  },
  "description": "Platform for Oyasai Server",
  "devDependencies": {
    "@biomejs/biome": "^2.0.0-beta.6",
    "@types/node": "^22.15.30",
    "npm-check-updates": "^18.0.1",
    "sort-package-json": "^3.2.1",
    "typescript": "^5.8.3"
  },
  "name": "platform",
  "scripts": {
    "build": "tsc --build",
    "check": "sort-package-json */**/package.json --quiet && biome check --write",
    "codegen": "codegen schema gen",
    "upgrade": "ncu --deep --upgrade --reject @oyasaiserver/*"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/*",
    "gen",
    "tests"
  ]
}
