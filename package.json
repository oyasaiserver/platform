{
  "name": "platform",
  "description": "Platform for Oyasai Server",
  "type": "module",
  "workspaces": [
    "apps/*",
    "gen/ts",
    "lib/ts",
    "infra/*",
    "packages/*",
    "tests"
  ],
  "scripts": {
    "build": "(tsc --build) & ./gradlew build --parallel",
    "check": "(biome check --write && sort-package-json */**/package.json --quiet) & ./gradlew spotlessApply",
    "bump": "ncu --deep --upgrade --reject @oyasaiserver/* --install always",
    "codegen": "codegen schema gen && npm run check"
  },
  "dependencies": {
    "@oyasaiserver/codegen": "^1.0.0",
    "@oyasaiserver/gen": "^1.0.0",
    "@oyasaiserver/lib": "^1.0.0",
    "tsx": "^4.19.4",
    "zod": "^3.25.56",
    "zx": "^8.5.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.0.0",
    "npm-check-updates": "^18.0.1",
    "sort-package-json": "^3.2.1",
    "typescript": "^5.8.3"
  }
}
