{
  "type": "module",
  "workspaces": [
    "apps/*",
    "config",
    "gen/proto/ts",
    "infra/cdktf",
    "lib/ts",
    "packages/*",
    "tests"
  ],
  "scripts": {
    "build": "tsc --build",
    "bump": "taze",
    "check": "biome check --write && sort-package-json '**/package.json' --quiet && buf format --write",
    "codegen": "codegen && (npm run check & ./gradlew spotlessApply)"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@bufbuild/buf": "^1.55.1",
    "@types/node": "^24.0.10",
    "sort-package-json": "^3.4.0",
    "taze": "^19.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "wrangler": "^4.23.0",
    "zx": "^8.6.1"
  }
}
