{
  "type": "module",
  "workspaces": [
    "apps/*",
    "bin",
    "config",
    "gen/json/ts",
    "gen/proto/ts",
    "infra/*",
    "lib/ts",
    "packages/*",
    "schema/ts"
  ],
  "scripts": {
    "build": "tsc --build",
    "bump": "taze",
    "check": "biome check --write && sort-package-json '**/package.json' --quiet && buf format --write && gradle spotlessApply",
    "codegen": "codegen && npm run check"
  },
  "dependencies": {
    "json-schema-to-typescript": "^15.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@bufbuild/buf": "^1.55.1",
    "@types/node": "^24.0.10",
    "sort-package-json": "^3.4.0",
    "taze": "^19.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "wrangler": "^4.23.0",
    "zod": "^3.25.73",
    "zx": "^8.6.1"
  }
}
