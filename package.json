{
  "type": "module",
  "workspaces": [
    "apps/*",
    "infra/*",
    "lib/ts",
    "packages/*",
    "secrets"
  ],
  "scripts": {
    "build": "tsc --build",
    "format": "prettier . --write",
    "lint": "oxlint --fix",
    "update": "taze latest --recursive --install --write"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "oxlint": "^1.16.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^2.5.19",
    "taze": "^19.7.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.38.0"
  }
}
