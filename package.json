{
  "type": "module",
  "workspaces": [
    "!**/static/**",
    "apps/*",
    "config",
    "gen/proto/ts",
    "infra/cdktf",
    "lib/ts",
    "packages/*",
    "tests"
  ],
  "scripts": {
    "build": "tsc --build",
    "bump": "ncu --deep --upgrade --reject @oyasaiserver/* --install always",
    "check": "biome check --write && sort-package-json '**/package.json' --quiet",
    "codegen": "codegen && (npm run check & ./gradlew spotlessApply)"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@types/node": "^24.0.10",
    "npm-check-updates": "^18.0.1",
    "sort-package-json": "^3.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "wrangler": "^4.22.0",
    "zod": "^3.25.67",
    "zx": "^8.6.1"
  }
}
