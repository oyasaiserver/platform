{
  "type": "module",
  "workspaces": [
    "apps/*",
    "infra/*",
    "lib/ts",
    "packages/*",
    "secrets"
  ],
  "scripts": {
    "build": "tsc --build",
    "format": "sort-package-json '**/package.json' && prettier . --write",
    "lint": "oxlint --fix",
    "update": "taze latest --recursive --install --write"
  },
  "dependencies": {
    "zx": "^8.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "oxlint": "^1.14.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "sort-package-json": "^3.4.0",
    "taze": "^19.4.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.33.2"
  }
}
