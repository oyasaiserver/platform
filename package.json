{
  "type": "module",
  "workspaces": [
    "apps/*",
    "gen/json/ts",
    "infra/*",
    "lib/ts",
    "packages/*",
    "schema/ts"
  ],
  "scripts": {
    "build": "tsc --build",
    "bump": "taze latest --recursive --install --write",
    "codegen": "codegen && npm run format && ./gradlew spotlessApply",
    "format": "sort-package-json '**/package.json' && prettier . --write",
    "lint": "oxlint --fix"
  },
  "dependencies": {
    "zod": "^4.0.17",
    "zx": "^8.8.0"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.0.4",
    "@types/node": "^24.3.0",
    "oxlint": "^1.12.0",
    "prettier": "^3.6.2",
    "sort-package-json": "^3.4.0",
    "taze": "^19.1.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.31.0"
  }
}
