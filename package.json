{
  "type": "module",
  "workspaces": [
    "apps/*",
    "infra/*",
    "lib/ts",
    "packages/*",
    "schema/ts"
  ],
  "scripts": {
    "build": "tsc --build",
    "format": "sort-package-json '**/package.json' && prettier . --write",
    "lint": "oxlint --fix",
    "update": "taze latest --recursive --install --write"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.0.4",
    "@types/node": "^24.3.0",
    "oxlint": "^1.13.0",
    "prettier": "^3.6.2",
    "sort-package-json": "^3.4.0",
    "taze": "^19.3.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.33.1"
  }
}
