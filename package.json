{
  "type": "module",
  "workspaces": [
    "apps/*",
    "infra/*",
    "lib/ts",
    "packages/*",
    "secrets"
  ],
  "scripts": {
    "build": "tsc --build",
    "format": "sort-package-json '**/package.json' && prettier . --write --log-level silent",
    "lint": "oxlint --fix",
    "update": "taze latest --recursive --install --write"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.5.2",
    "oxlint": "^1.16.0",
    "prettier": "^3.6.2",
    "sort-package-json": "^3.4.0",
    "taze": "^19.6.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.37.1"
  }
}
