#/-------------------[DOTENV_PUBLIC_KEY]--------------------/
#/            public-key encryption for .env files          /
#/       [how it works](https://dotenvx.com/encryption)     /
#/----------------------------------------------------------/
DOTENV_PUBLIC_KEY="030efc2bd0b198676bf6856e980f6c9d12e4cfcd5a4a7fb855cce5132fb14fc7ec"
ENVIRONMENT="local"

# onprem
PUBLIC_IPV4="192.0.2.0"
SSH_PRIVATE_KEY="unset"
SSH_USERNAME="unset"
SSH_PASSWORD="unset"

# cloudflare
CLOUDFLARE_ACCOUNT_ID="unset"
CLOUDFLARE_API_TOKEN="unset_unset_unset_unset_unset_unset_unset"
CLOUDFLARE_TUNNEL_SECRET="unset"
API_ENDPOINT="http://host.docker.internal:8787"
BEARER="unset"

# github
GITHUB_APP_ID="unset"
GITHUB_APP_INSTALLATION_ID="unset"
GITHUB_APP_PEM_FILE="unset"

# terraform
TF_API_TOKEN="unset"
TF_TOKEN_app_terraform_io=$TF_API_TOKEN
