{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/docs/02_Docs/ops/agent-footprint-logging/footprint-log.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/docs/02_Docs/ops/agent-footprint-logging/footprint-stop.sh\""
          }
        ]
      }
    ]
  }
}
