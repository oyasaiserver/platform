{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "web",
  "main": "src/index.ts",
  "compatibility_date": "2022-07-12",
  "workers_dev": false,
  "env": {
    "staging": {
      "name": "my-worker-staging",
      "route": {
        "pattern": "staging.example.org/*",
        "zone_name": "example.org"
      }
    }
  }
}
