{
  "$schema": "node_modules/lefthook/schema.json",
  "prepare-commit-msg": {
    "commands": {
      "commitizen": {
        "interactive": true,
        "run": "cz --hook"
      }
    }
  },
  "pre-commit": {
    "parallel": true,
    "jobs": [
      {
        "run": "npm run check",
        "stage_fixed": true
      },
      {
        "run": "npm run typecheck"
      }
    ]
  }
}
