{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "env",
  "type": "object",
  "additionalProperties": false,
  "readOnly": true,
  "properties": {
    "DOTENV_PUBLIC_KEY": {
      "type": "string"
    },
    "ENVIRONMENT": {
      "type": "string",
      "enum": ["production", "development", "local"]
    },
    "CLOUDFLARE_API_TOKEN": {
      "type": "string"
    },
    "TF_API_TOKEN": {
      "type": "string"
    },
    "TF_TOKEN_app_terraform_io": {
      "type": "string"
    }
  },
  "required": [
    "DOTENV_PUBLIC_KEY",
    "ENVIRONMENT",
    "CLOUDFLARE_API_TOKEN",
    "TF_API_TOKEN",
    "TF_TOKEN_app_terraform_io"
  ]
}
