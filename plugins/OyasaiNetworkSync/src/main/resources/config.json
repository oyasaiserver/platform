{
  "debug": false,
  "direct-chat": {
    "cancel-backend-chat": true,
    "enabled": true,
    "format": "<white>{player}<gray>: <white>{message}"
  },
  "server-detection": {
    "direct-chat-host-suffixes": ["-lobby"],
    "host-prefix": "oyasai-minecraft-"
  },
  "tab": {
    "enabled": true,
    "remote-display-name": "<gray>{player}",
    "remote-list-order": 1000
  },
  "venturechat": {
    "channel": "venturechat:data",
    "synced-channels": ["Global"]
  }
}
